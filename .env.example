# OpenEMR OAuth (server-only — never prefix with VITE_)
# Replace with your real OpenEMR base URL when copying to .env (no trailing slash).
OPENEMR_URL=https://openemr.titleredacted.cc
# Replace with your real OAuth client ID when copying to .env.
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
# Must match the redirect URI registered in OpenEMR (use Vite dev URL in development)
REDIRECT_URI=http://localhost:5173/callback

# BFF
PORT=3000

# Where to send the browser after successful OAuth (React app)
APP_ORIGIN=http://localhost:5173

# Optional: override Vite proxy target when running client separately
# VITE_BFF_ORIGIN=http://localhost:3000
